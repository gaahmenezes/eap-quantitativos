// Schema F1 — Fundação. Ver docs/database/README.md e ADR-007 (isolamento por organização).
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectRole {
  COORDINATOR
  EDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProjectClassification {
  VERTICAL
  HORIZONTAL
  LOTEAMENTO
  MISTO
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships       Membership[]
  invitations       Invitation[]
  projects          Project[]
  auditLogs         AuditLog[]
  systemTypes       InfrastructureSystemType[]
  elementTypes      ElementType[]
  unitOfMeasures    UnitOfMeasure[]
  serviceCategories ServiceCategory[]
  services          Service[]
  wbsTemplates      WbsTemplate[]

  @@map("organization")
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  email            String     @unique @db.VarChar(254)
  name             String     @db.VarChar(120)
  passwordHash     String     @db.VarChar(255)
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  memberships     Membership[]
  sessions        Session[]
  auditLogs       AuditLog[]
  invitationsSent Invitation[] @relation("InvitedBy")

  @@map("app_user")
}

model Membership {
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           OrgRole
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  projectMembers ProjectMember[]

  @@id([organizationId, userId])
  @@index([userId])
  @@map("membership")
}

model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  email          String    @db.VarChar(254)
  role           OrgRole
  tokenHash      String    @unique @db.VarChar(64)
  invitedById    String    @db.Uuid
  expiresAt      DateTime  @db.Timestamptz(3)
  acceptedAt     DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("invitation")
}

model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  tokenHash      String    @unique @db.VarChar(64)
  csrfToken      String    @db.VarChar(64)
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  ip             String?   @db.VarChar(64)
  userAgent      String?   @db.VarChar(400)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Project {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @db.Uuid
  code           String                @db.VarChar(30)
  name           String                @db.VarChar(200)
  description    String?               @db.VarChar(4000)
  classification ProjectClassification
  location       String?               @db.VarChar(300)
  status         ProjectStatus         @default(ACTIVE)
  archivedAt     DateTime?             @db.Timestamptz(3)
  version        Int                   @default(1)
  createdById    String                @db.Uuid
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  auditLogs    AuditLog[]
  modules      ProjectModule[]
  nodes        StructureNode[]
  typologies   DwellingTypology[]
  systems      InfrastructureSystem[]
  services     Service[]
  wbsNodes     WbsNode[]
  wbsRuns      WbsGenerationRun[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("project")
}

/// Membro de empreendimento: FK composta garante que o usuário é membro da MESMA organização do projeto.
model ProjectMember {
  organizationId String      @db.Uuid
  projectId      String      @db.Uuid
  userId         String      @db.Uuid
  role           ProjectRole
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  project    Project    @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  membership Membership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([organizationId, userId])
  @@map("project_member")
}

/// Auditoria append-only (trigger impede UPDATE/DELETE — ver migração).
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  projectId      String?  @db.Uuid
  actorId        String?  @db.Uuid
  entityType     String   @db.VarChar(60)
  entityId       String   @db.VarChar(64)
  action         String   @db.VarChar(40)
  before         Json?
  after          Json?
  reason         String?  @db.VarChar(500)
  requestId      String?  @db.VarChar(64)
  at             DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, projectId, at])
  @@map("audit_log")
}

// ===================== F2 — Cadastro físico =====================

enum ModuleKind {
  VERTICAL_RESIDENTIAL
  HORIZONTAL_RESIDENTIAL
  LAND_SUBDIVISION
  COMMON_AREAS
  INFRASTRUCTURE
}

enum StructureNodeKind {
  PHASE
  STAGE
  SECTOR
  BLOCK_QUADRA
  LOT
  STREET
  STREET_SECTION
  TOWER
  BUILDING_BLOCK
  FLOOR
  DWELLING_UNIT
  COMMON_AREA
  TECHNICAL_AREA
  INSTITUTIONAL_AREA
  GREEN_AREA
}

enum NodeOrigin {
  WIZARD
  MANUAL
  DUPLICATE
}

enum TypologyKind {
  APARTMENT
  HOUSE
}

/// Módulo do empreendimento (ADR-011). Misto = vários módulos.
model ProjectModule {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @db.Uuid
  projectId      String     @db.Uuid
  kind           ModuleKind
  name           String     @db.VarChar(120)
  position       Int
  code           String     @db.VarChar(20)
  archivedAt     DateTime?  @db.Timestamptz(3)
  version        Int        @default(1)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  project Project         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  nodes   StructureNode[]

  @@unique([id, organizationId])
  @@unique([id, projectId])
  @@index([organizationId, projectId])
  @@map("project_module")
}

/// Nó do cadastro físico (adjacência + caminho materializado, ADR-005).
/// `path` = IDs dos ancestrais separados por "/" (inclui o próprio id ao final).
model StructureNode {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  projectId      String            @db.Uuid
  moduleId       String            @db.Uuid
  parentId       String?           @db.Uuid
  kind           StructureNodeKind
  name           String            @db.VarChar(120)
  position       Int
  depth          Int
  path           String            @db.Text
  code           String            @db.VarChar(80)
  origin         NodeOrigin        @default(MANUAL)
  archivedAt     DateTime?         @db.Timestamptz(3)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  project       Project                @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  module        ProjectModule          @relation(fields: [moduleId, projectId], references: [id, projectId], onDelete: Restrict)
  parent        StructureNode?         @relation("NodeTree", fields: [parentId, projectId], references: [id, projectId], onDelete: Restrict)
  children      StructureNode[]        @relation("NodeTree")
  unit          DwellingUnit?
  lot           LotDetail?
  systemsScoped InfrastructureSystem[]
  networkNodes  NetworkNode[]
  segments      NetworkSegment[]
  elements      PhysicalElement[]

  @@unique([id, projectId])
  @@index([projectId, moduleId, parentId, position])
  @@index([projectId, path])
  @@map("structure_node")
}

/// Detalhe 1:1 de nós DWELLING_UNIT: vínculo com a tipologia.
model DwellingUnit {
  structureNodeId  String  @id @db.Uuid
  projectId        String  @db.Uuid
  typologyId       String? @db.Uuid
  /// Revisão publicada da tipologia que vale para esta unidade (RN-TIP). Só muda por propagação explícita.
  pinnedRevisionId String? @db.Uuid

  node           StructureNode     @relation(fields: [structureNodeId, projectId], references: [id, projectId], onDelete: Cascade)
  typology       DwellingTypology? @relation(fields: [typologyId, projectId], references: [id, projectId], onDelete: Restrict)
  pinnedRevision TypologyRevision? @relation(fields: [pinnedRevisionId, projectId], references: [id, projectId], onDelete: Restrict)
  overrides      UnitOverride[]

  @@unique([structureNodeId, projectId])
  @@index([projectId, typologyId])
  @@map("dwelling_unit")
}

/// Detalhe 1:1 de nós LOT: atributos tipados do lote (m², m).
model LotDetail {
  structureNodeId String   @id @db.Uuid
  projectId       String   @db.Uuid
  area            Decimal? @db.Decimal(14, 4)
  frontage        Decimal? @db.Decimal(10, 3)

  node StructureNode @relation(fields: [structureNodeId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([structureNodeId, projectId])
  @@map("lot_detail")
}

/// Tipologia construtiva do empreendimento (revisões e elementos chegam na F3).
model DwellingTypology {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  projectId      String       @db.Uuid
  code           String       @db.VarChar(20)
  name           String       @db.VarChar(120)
  kind           TypologyKind
  description    String?      @db.VarChar(2000)
  privateArea    Decimal?     @db.Decimal(12, 4)
  archivedAt     DateTime?    @db.Timestamptz(3)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  project   Project            @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  units     DwellingUnit[]
  revisions TypologyRevision[]

  @@unique([id, projectId])
  @@unique([projectId, code])
  @@map("dwelling_typology")
}

// ===================== F3 — Catálogo técnico, infraestrutura e construtivo =====================

enum ElementDomain {
  INFRA
  CONSTRUTIVO
}

enum ElementCategory {
  NETWORK_NODE
  NETWORK_SEGMENT
  ELEMENT
}

enum AttributeDataType {
  NUMBER
  TEXT
  BOOLEAN
  ENUM
}

enum RevisionStatus {
  DRAFT
  PUBLISHED
}

enum UnitOverrideOp {
  EXCLUDE_ELEMENT
  ADD_ELEMENT
}

/// Catálogo por organização: tipos de sistema de infraestrutura (extensível sem migração).
model InfrastructureSystemType {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  code           String    @db.VarChar(30)
  name           String    @db.VarChar(120)
  networkBased   Boolean
  archivedAt     DateTime? @db.Timestamptz(3)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  elementTypes ElementType[]
  systems      InfrastructureSystem[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@map("infrastructure_system_type")
}

/// Catálogo por organização: tipos de elemento físico com definição de atributos (ADR-010).
model ElementType {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @db.Uuid
  code           String          @db.VarChar(30)
  name           String          @db.VarChar(120)
  domain         ElementDomain
  category       ElementCategory
  systemTypeId   String?         @db.Uuid
  archivedAt     DateTime?       @db.Timestamptz(3)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  systemType       InfrastructureSystemType?    @relation(fields: [systemTypeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  attributes       ElementAttributeDefinition[]
  networkNodes     NetworkNode[]
  segments         NetworkSegment[]
  elements         PhysicalElement[]
  typologyElements TypologyElement[]
  overrides        UnitOverride[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@map("element_type")
}

model ElementAttributeDefinition {
  id            String            @id @default(uuid(7)) @db.Uuid
  elementTypeId String            @db.Uuid
  key           String            @db.VarChar(40)
  label         String            @db.VarChar(80)
  dataType      AttributeDataType
  unit          String?           @db.VarChar(16)
  required      Boolean           @default(false)
  enumValues    String[]
  min           Decimal?          @db.Decimal(18, 6)
  max           Decimal?          @db.Decimal(18, 6)
  position      Int

  elementType ElementType @relation(fields: [elementTypeId], references: [id], onDelete: Cascade)

  @@unique([elementTypeId, key])
  @@map("element_attribute_definition")
}

/// Sistema de infraestrutura no empreendimento (ex.: Drenagem da Fase 1).
model InfrastructureSystem {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  projectId      String    @db.Uuid
  systemTypeId   String    @db.Uuid
  name           String    @db.VarChar(120)
  /// Escopo opcional no cadastro físico (fase, setor, rua…).
  scopeNodeId    String?   @db.Uuid
  archivedAt     DateTime? @db.Timestamptz(3)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  project    Project                  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  systemType InfrastructureSystemType @relation(fields: [systemTypeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  scopeNode  StructureNode?           @relation(fields: [scopeNodeId, projectId], references: [id, projectId], onDelete: Restrict)
  networks   InfrastructureNetwork[]
  elements   PhysicalElement[]

  @@unique([id, projectId])
  @@index([organizationId, projectId])
  @@map("infrastructure_system")
}

model InfrastructureNetwork {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  projectId      String    @db.Uuid
  systemId       String    @db.Uuid
  code           String    @db.VarChar(30)
  name           String    @db.VarChar(120)
  archivedAt     DateTime? @db.Timestamptz(3)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  system   InfrastructureSystem @relation(fields: [systemId, projectId], references: [id, projectId], onDelete: Restrict)
  nodes    NetworkNode[]
  segments NetworkSegment[]

  @@unique([id, projectId])
  @@unique([systemId, code])
  @@map("infrastructure_network")
}

/// Dispositivo da rede (PV, boca de lobo, registro, poste…). Cotas em metros (NUMERIC).
model NetworkNode {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @db.Uuid
  projectId       String    @db.Uuid
  networkId       String    @db.Uuid
  elementTypeId   String    @db.Uuid
  code            String    @db.VarChar(30)
  locationNodeId  String?   @db.Uuid
  coverElevation  Decimal?  @db.Decimal(10, 3)
  bottomElevation Decimal?  @db.Decimal(10, 3)
  attributes      Json      @default("{}")
  archivedAt      DateTime? @db.Timestamptz(3)
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  network     InfrastructureNetwork @relation(fields: [networkId, projectId], references: [id, projectId], onDelete: Restrict)
  elementType ElementType           @relation(fields: [elementTypeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  location    StructureNode?        @relation(fields: [locationNodeId, projectId], references: [id, projectId], onDelete: Restrict)
  outgoing    NetworkSegment[]      @relation("SegmentFrom")
  incoming    NetworkSegment[]      @relation("SegmentTo")

  @@unique([id, networkId])
  @@unique([networkId, code])
  @@map("network_node")
}

/// Trecho entre dois dispositivos da MESMA rede (FKs compostas com networkId).
model NetworkSegment {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @db.Uuid
  projectId        String    @db.Uuid
  networkId        String    @db.Uuid
  elementTypeId    String    @db.Uuid
  code             String    @db.VarChar(30)
  fromNodeId       String    @db.Uuid
  toNodeId         String    @db.Uuid
  streetSectionId  String?   @db.Uuid
  /// m
  length           Decimal   @db.Decimal(12, 3)
  /// mm (diâmetro nominal)
  diameter         Decimal?  @db.Decimal(8, 1)
  material         String?   @db.VarChar(60)
  /// Cotas de fundo (geratriz inferior) em m
  upstreamInvert   Decimal?  @db.Decimal(10, 3)
  downstreamInvert Decimal?  @db.Decimal(10, 3)
  attributes       Json      @default("{}")
  archivedAt       DateTime? @db.Timestamptz(3)
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  network       InfrastructureNetwork @relation(fields: [networkId, projectId], references: [id, projectId], onDelete: Restrict)
  elementType   ElementType           @relation(fields: [elementTypeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  fromNode      NetworkNode           @relation("SegmentFrom", fields: [fromNodeId, networkId], references: [id, networkId], onDelete: Restrict)
  toNode        NetworkNode           @relation("SegmentTo", fields: [toNodeId, networkId], references: [id, networkId], onDelete: Restrict)
  streetSection StructureNode?        @relation(fields: [streetSectionId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([networkId, code])
  @@index([networkId, fromNodeId])
  @@map("network_segment")
}

/// Elemento físico avulso: de um sistema de infraestrutura (pavimento, guia, área de terraplenagem)
/// e/ou localizado num nó do cadastro (área comum, rua, trecho).
model PhysicalElement {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @db.Uuid
  projectId       String    @db.Uuid
  elementTypeId   String    @db.Uuid
  systemId        String?   @db.Uuid
  structureNodeId String?   @db.Uuid
  name            String    @db.VarChar(120)
  attributes      Json      @default("{}")
  archivedAt      DateTime? @db.Timestamptz(3)
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  elementType   ElementType           @relation(fields: [elementTypeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  system        InfrastructureSystem? @relation(fields: [systemId, projectId], references: [id, projectId], onDelete: Restrict)
  structureNode StructureNode?        @relation(fields: [structureNodeId, projectId], references: [id, projectId], onDelete: Restrict)

  @@index([projectId, systemId])
  @@index([projectId, structureNodeId])
  @@map("physical_element")
}

/// Revisão da tipologia. PUBLISHED é imutável (trigger); no máximo um DRAFT por tipologia.
model TypologyRevision {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  projectId      String         @db.Uuid
  typologyId     String         @db.Uuid
  number         Int
  status         RevisionStatus @default(DRAFT)
  notes          String?        @db.VarChar(1000)
  publishedAt    DateTime?      @db.Timestamptz(3)
  publishedById  String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  typology DwellingTypology  @relation(fields: [typologyId, projectId], references: [id, projectId], onDelete: Restrict)
  elements TypologyElement[]
  units    DwellingUnit[]

  @@unique([id, projectId])
  @@unique([typologyId, number])
  @@map("typology_revision")
}

/// Elemento de uma revisão. `stableKey` é preservado entre revisões (identidade do elemento na tipologia).
model TypologyElement {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  revisionId     String  @db.Uuid
  parentId       String? @db.Uuid
  stableKey      String  @db.Uuid
  elementTypeId  String  @db.Uuid
  name           String  @db.VarChar(120)
  attributes     Json    @default("{}")
  position       Int

  revision    TypologyRevision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  parent      TypologyElement?  @relation("TypologyElementTree", fields: [parentId, revisionId], references: [id, revisionId], onDelete: Cascade)
  children    TypologyElement[] @relation("TypologyElementTree")
  elementType ElementType       @relation(fields: [elementTypeId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, revisionId])
  @@unique([revisionId, stableKey])
  @@map("typology_element")
}

/// Particularidade de uma unidade em relação à tipologia. Nunca é apagada: remoção = arquivamento.
model UnitOverride {
  id              String         @id @default(uuid(7)) @db.Uuid
  organizationId  String         @db.Uuid
  projectId       String         @db.Uuid
  unitId          String         @db.Uuid
  op              UnitOverrideOp
  targetStableKey String?        @db.Uuid
  parentStableKey String?        @db.Uuid
  elementTypeId   String?        @db.Uuid
  name            String?        @db.VarChar(120)
  attributes      Json?
  reason          String         @db.VarChar(500)
  createdById     String         @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  archivedAt      DateTime?      @db.Timestamptz(3)
  archiveReason   String?        @db.VarChar(500)

  unit        DwellingUnit @relation(fields: [unitId, projectId], references: [structureNodeId, projectId], onDelete: Restrict)
  elementType ElementType? @relation(fields: [elementTypeId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([projectId, unitId])
  @@map("unit_override")
}

// ===================== F4 — Unidades de medida e biblioteca de serviços =====================

enum ServiceOrigin {
  CATALOG
  PROJECT
  DUPLICATE
  IMPORT
}

/// Unidade de medida da organização com dimensão [L, M, T, N] e fator exato para a base.
/// Dimensão e fator são imutáveis depois que a unidade é usada (trigger).
model UnitOfMeasure {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  symbol         String    @db.VarChar(12)
  name           String    @db.VarChar(60)
  dimL           Int       @db.SmallInt
  dimM           Int       @db.SmallInt
  dimT           Int       @db.SmallInt
  dimN           Int       @db.SmallInt
  factor         Decimal   @db.Decimal(40, 30)
  decimals       Int       @db.SmallInt
  system         Boolean   @default(false)
  archivedAt     DateTime? @db.Timestamptz(3)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  services     Service[]

  @@unique([id, organizationId])
  @@unique([organizationId, symbol])
  @@map("unit_of_measure")
}

/// Categoria (árvore) da biblioteca de serviços da organização.
model ServiceCategory {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  parentId       String?   @db.Uuid
  code           String    @db.VarChar(30)
  name           String    @db.VarChar(120)
  position       Int
  archivedAt     DateTime? @db.Timestamptz(3)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       ServiceCategory?  @relation("CategoryTree", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children     ServiceCategory[] @relation("CategoryTree")
  services     Service[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@map("service_category")
}

/// Serviço técnico quantificável. projectId nulo = catálogo da organização; preenchido = específico do empreendimento.
/// Sem nenhum campo financeiro (regra 1).
model Service {
  id                    String        @id @default(uuid(7)) @db.Uuid
  organizationId        String        @db.Uuid
  projectId             String?       @db.Uuid
  code                  String        @db.VarChar(30)
  description           String        @db.VarChar(300)
  normalizedDescription String        @db.VarChar(300)
  categoryId            String        @db.Uuid
  unitId                String        @db.Uuid
  measurementCriterion  String?       @db.VarChar(2000)
  technicalDescription  String?       @db.VarChar(4000)
  origin                ServiceOrigin
  derivedFromId         String?       @db.Uuid
  archivedAt            DateTime?     @db.Timestamptz(3)
  version               Int           @default(1)
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  category     ServiceCategory  @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  unit         UnitOfMeasure    @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  derivedFrom  Service?         @relation("ServiceDerivation", fields: [derivedFromId, organizationId], references: [id, organizationId], onDelete: Restrict)
  derivatives  Service[]        @relation("ServiceDerivation")
  wbsLinks     WbsNodeService[]

  @@unique([id, organizationId])
  @@index([organizationId, projectId, categoryId])
  @@map("service")
}

// ===================== F5 — Templates e EAP =====================

enum WbsNodeType {
  GROUP
  ITEM
}

enum WbsNodeOrigin {
  GENERATED
  MANUAL
}

enum WbsNodeStatus {
  ACTIVE
  OBSOLETE
}

enum WbsRepeatScope {
  TOWER
  BUILDING_BLOCK
  FLOOR
  DWELLING_UNIT
  DWELLING_TYPOLOGY
  COMMON_AREA
  SPECIAL_AREA
  PHASE
  STAGE
  SECTOR
  BLOCK_QUADRA
  LOT
  STREET
  STREET_SECTION
  INFRA_SYSTEM
  NETWORK
}

enum WbsBindingKind {
  MODULE
  STRUCTURE
  TYPOLOGY
  SYSTEM
  NETWORK
}

/// Template de EAP da organização.
model WbsTemplate {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  code           String       @db.VarChar(30)
  name           String       @db.VarChar(120)
  description    String?      @db.VarChar(1000)
  moduleKinds    ModuleKind[]
  archivedAt     DateTime?    @db.Timestamptz(3)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     WbsTemplateVersion[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@map("wbs_template")
}

/// Versão do template. PUBLISHED é imutável (trigger); um único DRAFT por template.
model WbsTemplateVersion {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  templateId     String         @db.Uuid
  number         Int
  status         RevisionStatus @default(DRAFT)
  notes          String?        @db.VarChar(1000)
  publishedAt    DateTime?      @db.Timestamptz(3)
  publishedById  String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  template WbsTemplate       @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  nodes    WbsTemplateNode[]
  wbsNodes WbsNode[]

  @@unique([id, organizationId])
  @@unique([templateId, number])
  @@map("wbs_template_version")
}

/// Nó do template: título com variáveis, tipo, condição, repetição e serviços sugeridos.
/// `stableKey` é preservado entre versões e compõe a generationKey dos nós gerados.
model WbsTemplateNode {
  id         String          @id @default(uuid(7)) @db.Uuid
  versionId  String          @db.Uuid
  parentId   String?         @db.Uuid
  stableKey  String          @db.VarChar(60)
  title      String          @db.VarChar(200)
  nodeType   WbsNodeType
  condition  String?         @db.VarChar(500)
  repeat     WbsRepeatScope?
  position   Int
  serviceIds String[]        @db.Uuid

  version  WbsTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  parent   WbsTemplateNode?   @relation("TemplateNodeTree", fields: [parentId, versionId], references: [id, versionId], onDelete: Cascade)
  children WbsTemplateNode[]  @relation("TemplateNodeTree")

  @@unique([id, versionId])
  @@unique([versionId, stableKey])
  @@map("wbs_template_node")
}

/// Nó da EAP do empreendimento — independente do cadastro físico (vínculos opcionais por ID).
model WbsNode {
  id                  String          @id @default(uuid(7)) @db.Uuid
  organizationId      String          @db.Uuid
  projectId           String          @db.Uuid
  parentId            String?         @db.Uuid
  title               String          @db.VarChar(200)
  code                String          @db.VarChar(80)
  depth               Int
  position            Int
  path                String          @db.Text
  nodeType            WbsNodeType
  origin              WbsNodeOrigin
  status              WbsNodeStatus   @default(ACTIVE)
  generationKey       String?         @db.VarChar(600)
  moduleId            String?         @db.Uuid
  templateVersionId   String?         @db.Uuid
  templateNodeKey     String?         @db.VarChar(60)
  bindingKind         WbsBindingKind?
  bindingId           String?         @db.Uuid
  titleOverridden     Boolean         @default(false)
  placementOverridden Boolean         @default(false)
  archivedAt          DateTime?       @db.Timestamptz(3)
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  project         Project             @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parent          WbsNode?            @relation("WbsTree", fields: [parentId, projectId], references: [id, projectId], onDelete: Restrict)
  children        WbsNode[]           @relation("WbsTree")
  templateVersion WbsTemplateVersion? @relation(fields: [templateVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  services        WbsNodeService[]

  @@unique([id, projectId])
  @@index([projectId, parentId, position])
  @@index([projectId, path])
  @@map("wbs_node")
}

/// Serviços associados a um item quantificável da EAP.
model WbsNodeService {
  wbsNodeId      String   @db.Uuid
  projectId      String   @db.Uuid
  organizationId String   @db.Uuid
  serviceId      String   @db.Uuid
  fromTemplate   Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  node    WbsNode @relation(fields: [wbsNodeId, projectId], references: [id, projectId], onDelete: Cascade)
  service Service @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([wbsNodeId, serviceId])
  @@index([projectId, serviceId])
  @@map("wbs_node_service")
}

/// Registro de cada geração/regeneração aplicada (reprodutibilidade e auditoria).
model WbsGenerationRun {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  projectId      String   @db.Uuid
  selections     Json
  factsHash      String   @db.VarChar(16)
  resultHash     String   @db.VarChar(16)
  summary        Json
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@map("wbs_generation_run")
}
