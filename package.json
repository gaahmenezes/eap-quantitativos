{
  "name": "eap-quantitativos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter @eapq/domain --filter @eapq/contracts build",
    "dev": "pnpm build:packages && pnpm --parallel --filter @eapq/api --filter @eapq/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm build:packages && pnpm -r test",
    "e2e": "pnpm --filter @eapq/web e2e",
    "db:up": "docker compose up -d db"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "overrides": {
      "exceljs>uuid": "11.1.1",
      "@prisma/config>effect": "3.22.5"
    }
  }
}
